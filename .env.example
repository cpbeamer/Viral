# ============================================================
# Viral — Social Media Wind Tunnel Configuration
# ============================================================
# Copy this file to .env and fill in your values

# --- LLM Configuration ---
# Any OpenAI-compatible API (OpenAI, Groq, Together AI, Alibaba DashScope, etc.)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: separate "boost" LLM for speed-critical tasks
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here

# --- Zep Memory Service ---
ZEP_API_KEY=your-zep-api-key-here

# --- Flask ---
SECRET_KEY=change-me-in-production
FLASK_DEBUG=True

# --- OASIS Simulation ---
OASIS_DEFAULT_MAX_ROUNDS=10

# --- Report Agent ---
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# --- Viral Wind Tunnel ---
# Default population size for batch agent generation
VIRAL_DEFAULT_POPULATION_SIZE=10000

# Default subculture preset (crypto_twitter, political_junkies, gen_z_gamers, default)
VIRAL_DEFAULT_SUBCULTURE=default

# LLM enrichment threshold — top N% of agents get full LLM-generated personas
VIRAL_LLM_ENRICHMENT_PERCENT=1

# Feed algorithm weights (must sum to 1.0)
VIRAL_FEED_RECENCY_WEIGHT=0.30
VIRAL_FEED_POPULARITY_WEIGHT=0.25
VIRAL_FEED_RELEVANCE_WEIGHT=0.25
VIRAL_FEED_ECHO_WEIGHT=0.20

# Feed noise factor (randomness injected into feed ranking, 0.0-0.5)
VIRAL_FEED_NOISE=0.10

# Cascade dashboard polling interval (milliseconds)
VIRAL_DASHBOARD_POLL_MS=3000